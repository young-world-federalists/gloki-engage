# Application-wide settings, read at build time by Vite (src/services/applicationServer.ts).
# REQUIRED: vite.config.ts refuses to build without them; this file is their only default.
# Override locally in .env.local (gitignored) or with environment variables in CI.

# The node of the central application account, which holds the application
# settings contract (e.g. where the verification contract lives).
VITE_APPLICATION_SERVER_URL=https://gdi.gloki.contact

# The central application account on that node.
VITE_APPLICATION_AGENT=gloki-application
