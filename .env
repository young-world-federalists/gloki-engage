# Application-wide settings, read at build time by Vite (src/services/applicationServer.ts).
# REQUIRED: vite.config.ts refuses to build without them; this file is their only default.
# Override locally in .env.local (gitignored) or with environment variables in CI.

# The ibc-go node of the central application account. It is also the node the
# login suggests to newcomers.
VITE_APPLICATION_SERVER_URL=https://ouri.gloki.contact

# The central application account on that node (its agent id, 0x…), and its
# application settings contract (ApplicationSettings.sol, deployed public).
# Made once per network, from any machine with this repo (it prints both lines):
#   node tools/setup-application.mjs <node url> <key file>
VITE_APPLICATION_AGENT=
VITE_APPLICATION_SETTINGS_CONTRACT=
