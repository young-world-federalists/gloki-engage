# Application-wide defaults, read at build time by Vite (src/services/applicationServer.ts).
# Override locally in .env.local (gitignored) or with environment variables in CI.

# The node that hosts application-wide contracts (e.g. the verification contract).
VITE_APPLICATION_SERVER_URL=https://gdi.gloki.contact

# The agent on that node that owns application-wide contracts.
VITE_APPLICATION_AGENT=gloki-application
